# Port
PORT=3000

# የእርስዎ Render Web Service URL (ለምሳሌ፡ https://my-crypto-service.onrender.com)
APP_URL="https://your-service.onrender.com"

# 12 ወይም 24 ቃላት ያሉት የእርስዎ Master Mnemonic Phrase (አድራሻዎችን ለማመንጨት ብቻ የሚያገለግል)
MASTER_MNEMONIC="test test test test test test test test test test test junk"

# --- 🤖 Telegram Admin Bot ቅንብሮች ---
# @BotFather ላይ Bot ፈጥረው የሚያገኙት Token
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# የእርስዎ የግል ቴሌግራም ID (@userinfobot ላይ ማግኘት ይችላሉ)
TELEGRAM_ADMIN_CHAT_ID="123456789"

# RPC Endpoints (Default ነፃ public RPCዎች ተዘጋጅተዋል)
POLYGON_RPC_URL="https://polygon-rpc.com"
BSC_RPC_URL="https://bsc-dataseed.binance.org"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
TON_API_URL="https://toncenter.com/api/v2/jsonRPC"
TON_API_KEY=""

# የክፍያ ጊዜ ማብቂያ በደቂቃ (Invoice Expiration in Minutes)
INVOICE_EXPIRY_MINUTES=60

# ስንት ሰከንድ አንድ ጊዜ ክፍያዎችን ፈልጎ ያረጋግጥ (Poll interval in seconds)
WATCHER_INTERVAL_SECONDS=10
