# Port
PORT=3000

# የእርስዎ Render Web Service URL
APP_URL="https://your-service.onrender.com"

# 12 ቃላት ያሉት የእርስዎ Master Mnemonic (ለ Polygon እና BEP20)
MASTER_MNEMONIC="birth soccer possible salt sauce praise ugly hotel field rack marine push"

# 🤖 Telegram Admin Bot
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
TELEGRAM_ADMIN_CHAT_ID="your_telegram_user_id"

# 🇪🇹 የሀገር ውስጥ ባንኮች (Telebirr & CBE)
TELEBIRR_PHONE="0911223344"
CBE_ACCOUNT="1000123456789"
MERCHANT_NAME="Abebe Kebede"
USDT_TO_ETB_RATE=130

# Blockchain High-Speed RPCs
POLYGON_RPC_URL="https://polygon-bor-rpc.publicnode.com"
BSC_RPC_URL="https://bsc-rpc.publicnode.com"

# ስንት ሰከንድ አንድ ጊዜ ክፍያዎችን ፈልጎ ያረጋግጥ
WATCHER_INTERVAL_SECONDS=10
